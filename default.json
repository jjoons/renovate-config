{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    "docker:pinDigests"
  ],
  "minimumReleaseAge": "5 days",
  "osvVulnerabilityAlerts": true,
  "prCreation": "not-pending",
  "semanticCommits": "enabled",
  "lockFileMaintenance": {
    "enabled": true
  },
  "packageRules": [
    {
      "description": "Disable minimumReleaseAge for pin and pinDigest update types",
      "matchUpdateTypes": ["pin", "pinDigest"],
      "minimumReleaseAge": null
    },
    {
      "description": "Automerge minor and patch, digest update types",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch", "pin", "pinDigest", "digest"],
      "automerge": true
    },
    {
      "description": "Set minimum release age optional to Docker datasource",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/renovatebot/renovate"],
      "minimumReleaseAgeBehaviour": "timestamp-optional",
      "automerge": false
    }
  ]
}
